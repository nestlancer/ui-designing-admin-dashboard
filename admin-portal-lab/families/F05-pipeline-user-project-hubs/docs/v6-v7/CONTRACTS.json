  "/api/v1/admin/progress/projects/{projectId}": {
    "service": "progress",
    "summary": "List progress entries for project",
    "parameters": [
      {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Project UUID"
      },
      {
        "name": "type",
        "in": "query",
        "required": false,
        "schema": {
          "example": "UPDATE",
          "enum": [
            "UPDATE",
            "MILESTONE_COMPLETE",
            "DELIVERABLE_UPLOAD",
            "STATUS_CHANGE",
            "INTERNAL_NOTE"
          ],
          "type": "string"
        },
        "description": "Filter by type of progress entry"
      },
      {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "minimum": 1,
          "default": 1,
          "example": 1,
          "type": "number"
        },
        "description": "Page number for pagination"
      },
      {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "example": 20,
          "type": "number"
        },
        "description": "Number of items per page"
      },
      {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "minimum": 1,
          "maximum": 100,
          "example": 20,
          "type": "number"
        },
        "description": "Alias of limit. Accepted so clients using pageSize are not rejected."
      }
    ],
    "response200": {
      "description": "ProgressEntryResponseDto wrapped in the standard success envelope",
      "content": {
        "application/json": {
          "schema": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiSuccessEnvelopeDto"
              },
              {
                "type": "object",
                "required": [
                  "status",
                  "data",
                  "metadata"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "success"
                    ]
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ProgressEntryResponseDto"
                    }
                  },
                  "metadata": {
                    "$ref": "#/components/schemas/ResponseMetadataDto"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },

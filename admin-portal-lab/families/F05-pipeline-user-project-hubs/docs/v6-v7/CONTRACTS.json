  "/api/v1/admin/payments": {
    "service": "payments",
    "summary": "List all payments (Admin)",
    "parameters": [
      {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "enum": [
            "CREATED",
            "PENDING",
            "PROCESSING",
            "PENDING_VERIFICATION",
            "COMPLETED",
            "FAILED",
            "REFUNDED",
            "DISPUTED",
            "CANCELLED",
            "NOT_DUE"
          ],
          "type": "string"
        },
        "description": "Filter payments by status. PENDING = due/payable open rows; NOT_DUE = open rows not yet payable."
      },
      {
        "name": "projectId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Filter payments by project ID"

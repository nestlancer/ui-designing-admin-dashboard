        "schema": {
          "minimum": 1,
          "default": 1,
          "example": 1,
          "type": "number"
        },
        "description": "Page number for pagination"
      },
      {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "minimum": 1,
          "default": 20,
          "example": 20,
          "type": "number"
        },
        "description": "Number of items per page"
      },
      {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "minimum": 1,
          "example": 20,
          "type": "number"
        },
        "description": "Alias for limit (cross-service pagination)"
      }
    ],
    "response200": {
      "description": "Standard success envelope",
      "content": {
        "application/json": {
          "schema": {
            "allOf": [
